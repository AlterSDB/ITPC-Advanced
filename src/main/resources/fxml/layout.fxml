<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="640.0" prefWidth="1009.0" styleClass="root" stylesheets="@../styles/night_grey.css" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.itpc_advanced.view.LayoutController">
   <children>
      <ImageView fx:id="logoImageView" disable="true" fitHeight="81.0" fitWidth="272.0" layoutX="14.0" layoutY="550.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../images/biglogo.png" />
         </image>
      </ImageView>
      <Button fx:id="settingsBtn" layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#onSettingsBtnAction" text="Settings" />
      <fx:include source="input.fxml" layoutX="0.0" layoutY="30.0"/>
      <fx:include source="output.fxml" layoutX="450.0" layoutY="30.0"/>
   </children>
</AnchorPane>
